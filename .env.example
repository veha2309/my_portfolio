# Vercel server-only settings. Copy to ignored .env.local for local use.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-server-only-supabase-secret-key
# A legacy SUPABASE_SERVICE_ROLE_KEY is also supported instead of SUPABASE_SECRET_KEY.
# Generate these two using node scripts/configure-admin.mjs:
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
